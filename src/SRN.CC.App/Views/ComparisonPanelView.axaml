<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SRN.CC.App.ViewModels"
             xmlns:previewVm="using:SRN.CC.App.ViewModels.Preview"
             x:Class="SRN.CC.App.Views.ComparisonPanelView"
             x:DataType="vm:ComparisonPanelViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- One ResourceDictionary per family, per architecture decision A3 - Wave-3 slices
                     each add their own template file here (and the matching StaticResource line
                     below) without touching this file's shared visual content or the other
                     families' entries. -->
                <ResourceInclude Source="avares://SRN.CC.App/Views/PreviewTemplates/TextPreviewTemplate.axaml"/>
                <ResourceInclude Source="avares://SRN.CC.App/Views/PreviewTemplates/ImagePreviewTemplate.axaml"/>
                <ResourceInclude Source="avares://SRN.CC.App/Views/PreviewTemplates/AudioPreviewTemplate.axaml"/>
                <ResourceInclude Source="avares://SRN.CC.App/Views/PreviewTemplates/ModelPreviewTemplate.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.DataTemplates>
        <!--
            Avalonia only resolves IMPLICIT (by-type) data templates from a control's DataTemplates
            list (walking the logical tree, then Application.DataTemplates) - never from Resources,
            even when a resource is keyed by Type. So each family's template, though authored and
            merged as a keyed resource above, must also be listed here once via StaticResource so
            ContentControl can find it by TextContentViewModel/ImageContentViewModel/etc.'s runtime
            type. This list is the ONE place a new family's one-line registration goes; the template
            content itself always lives in that family's own PreviewTemplates/*.axaml file.
        -->
        <StaticResource ResourceKey="{x:Type previewVm:TextContentViewModel}"/>
        <StaticResource ResourceKey="{x:Type previewVm:ImageContentViewModel}"/>
        <StaticResource ResourceKey="{x:Type previewVm:AudioContentViewModel}"/>
        <StaticResource ResourceKey="{x:Type previewVm:ModelViewportViewModel}"/>
    </UserControl.DataTemplates>
    <Grid RowDefinitions="Auto,*">
        <!-- Comparison Header & Mode Switcher -->
        <Border Grid.Row="0" Background="#252526" Padding="8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Preview &amp; Comparison Slots" FontWeight="Bold" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                <Button Grid.Column="1" Command="{Binding ToggleModeCommand}" Content="{Binding Mode, StringFormat='Mode: {0}'}"/>
            </Grid>
        </Border>

        <!-- 3 Comparison Slots -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Slots}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PreviewSlotViewModel">
                    <Border Margin="4" Padding="6" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Slot Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Text="{Binding SlotTitle}" FontWeight="Bold" Foreground="#007ACC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <!-- Replace this slot with the next selected candidate not already
                                     shown. Only visible when more than three items are selected. -->
                                <Button Grid.Column="1"
                                        Content="⇄"
                                        Margin="0,0,4,0"
                                        ToolTip.Tip="Replace this slot with the next selected item"
                                        IsVisible="{Binding $parent[ItemsControl].((vm:ComparisonPanelViewModel)DataContext).HasOverflowCandidates}"
                                        Command="{Binding $parent[ItemsControl].((vm:ComparisonPanelViewModel)DataContext).ReplaceSlotCommand}"
                                        CommandParameter="{Binding SlotIndex}"/>
                                <!-- One picker rather than seven buttons: the buttons consumed the
                                     whole slot header and pushed Pin off the panel edge. The
                                     selection is the slot's PreferredFamily, which auto-detection
                                     sets when an occurrence is assigned, so the picker also shows
                                     which rendering is currently on screen. -->
                                <ComboBox Grid.Column="2"
                                          MinWidth="104"
                                          FontSize="11"
                                          ItemsSource="{Binding Families}"
                                          SelectedItem="{Binding PreferredFamily, Mode=TwoWay}"
                                          ToolTip.Tip="Preview rendering for this slot"/>
                                <Button Grid.Column="3" Command="{Binding PinThisOccurrenceCommand}" Margin="4,0,0,0" IsEnabled="{Binding IsPinEnabled}" ToolTip.Tip="Pin Occurrence" Content="📌 Pin" />
                            </Grid>

                            <!-- Slot Content -->
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <ContentControl Content="{Binding Content}"/>

                                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="#FF4444" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
