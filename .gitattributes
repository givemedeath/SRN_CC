# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force CRLF for Windows scripts and solution files
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.hak binary
*.erf binary
