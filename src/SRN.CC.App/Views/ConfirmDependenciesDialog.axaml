<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SRN.CC.App.ViewModels"
        x:Class="SRN.CC.App.Views.ConfirmDependenciesDialog"
        x:DataType="vm:ConfirmDependenciesDialogViewModel"
        Title="Confirm Dependencies"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Orientation="Vertical" Spacing="12" Margin="16">
        <!-- Title -->
        <TextBlock Text="Dependency Closure Summary" FontSize="18" FontWeight="Bold" Foreground="#DDDDDD"/>

        <!-- Content Area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="350">
            <StackPanel Orientation="Vertical" Spacing="12" Margin="0,0,8,0">
                <!-- Summary Stats -->
                <Grid ColumnDefinitions="*,*,*">
                    <Border Padding="12" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="Resolved Assets" Foreground="#888888" FontSize="12"/>
                            <TextBlock Text="{Binding Summary.Resolved.Count}" Foreground="#00AA00" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="12" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="Total Size" Foreground="#888888" FontSize="12"/>
                            <TextBlock Text="{Binding Summary.TotalBytes}" Foreground="#00AA00" FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="12" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="Max Depth" Foreground="#888888" FontSize="12"/>
                            <TextBlock Text="{Binding Summary.MaxDepth}" Foreground="#00AA00" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Unresolved Dependencies -->
                <StackPanel Orientation="Vertical" Spacing="8">
                    <TextBlock Text="Unresolved Dependencies" FontWeight="Bold" Foreground="#DDDDDD" FontSize="14"/>

                    <ItemsControl ItemsSource="{Binding Summary.UnresolvedGroups}" IsVisible="{Binding Summary.UnresolvedGroups.Count}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="2" Margin="0,4,0,0">
                                    <StackPanel Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="{Binding Family, StringFormat='Family: {0}'}" Foreground="#CE9178" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Count, StringFormat='Count: {0}'}" Foreground="#9CDCFE"/>
                                        <ItemsControl ItemsSource="{Binding ReasonGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="16,2,0,0" Foreground="#FF7F50">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}• {0}: {1} items">
                                                                <Binding Path="Key"/>
                                                                <Binding Path="Value.Count"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No unresolved dependencies found." Foreground="#888888" IsVisible="{Binding !Summary.UnresolvedGroups.Count}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Button Bar -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Command="{Binding CancelSelectionCommand}" Content="Cancel" Padding="12,6" Foreground="#DDDDDD" Background="#C50F1F"/>
            <Button Command="{Binding ConfirmSelectionCommand}" Content="Continue" Padding="12,6" Foreground="#FFFFFF" Background="#007ACC"/>
        </StackPanel>
    </StackPanel>
</Window>
