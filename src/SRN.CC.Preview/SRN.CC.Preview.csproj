<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Required by SilkGlDevice (Render/Gl/) for direct Silk.NET.OpenGL pointer-taking overloads
         (glDrawElements element-buffer offsets, glGetString marshaling). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SRN.CC.Core\SRN.CC.Core.csproj" />
    <ProjectReference Include="..\SRN.CC.Formats\SRN.CC.Formats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pfim" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="Silk.NET.OpenGL" />
  </ItemGroup>
</Project>
