<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SRN.CC.App.ViewModels"
             x:Class="SRN.CC.App.Views.SourceStackView"
             x:DataType="vm:SourceStackViewModel">
    <Grid RowDefinitions="Auto,*">
        <!-- Header & Toolbar -->
        <!-- The title sits on its own row above the buttons. Sharing one row with six buttons left
             the panel's fixed 280px width unable to give the title its full text, so it rendered
             clipped to "Source Pri" and ran under the first button. -->
        <Border Grid.Row="0" Background="#252526" Padding="8">
            <StackPanel Spacing="6">
                <TextBlock Text="Source Priority Stack" FontWeight="Bold" Foreground="#DDDDDD"/>
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                    <Button Grid.Column="0" Command="{Binding RescanSourcesCommand}" ToolTip.Tip="Rescan All Sources">↺</Button>
                    <Button Grid.Column="1" Command="{Binding MoveUpCommand}" Margin="4,0,0,0" ToolTip.Tip="Move Source Up">▲</Button>
                    <Button Grid.Column="2" Command="{Binding MoveDownCommand}" Margin="4,0,0,0" ToolTip.Tip="Move Source Down">▼</Button>
                    <Button Grid.Column="3" Command="{Binding RemoveSourceCommand}" Margin="4,0,0,0" ToolTip.Tip="Remove Selected Source">✕</Button>
                    <Button Grid.Column="5" Command="{Binding AddHakSourceCommand}" Margin="4,0,0,0" ToolTip.Tip="Add HAK Source">+ HAK</Button>
                    <Button Grid.Column="6" Command="{Binding AddFolderSourceCommand}" Margin="4,0,0,0" ToolTip.Tip="Add Folder Source">+ Folder</Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Source List -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Background="#1E1E1E">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SourceItemViewModel">
                    <Border Padding="6" Margin="2" Background="#2D2D30" CornerRadius="4">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding PriorityOrdinal, StringFormat='[{0}]'}" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding PathDisplay}" FontSize="11" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding KindDisplay}" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
