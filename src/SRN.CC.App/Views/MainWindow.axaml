<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SRN.CC.App.ViewModels"
        xmlns:views="using:SRN.CC.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="SRN.CC.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800">

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#333337" Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="SRN.CC Asset Curator" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="8,0,16,0" Foreground="#FFFFFF"/>
                <Button x:Name="NewProjectButton" Content="New Project" Command="{Binding NewProjectCommand}"/>
                <Button x:Name="OpenProjectButton" Content="Open..." Command="{Binding OpenProjectCommand}"/>
                <Button x:Name="SaveProjectButton" Content="Save" Command="{Binding SaveProjectCommand}"/>
                <Button x:Name="SaveProjectAsButton" Content="Save As..." Command="{Binding SaveProjectAsCommand}"/>
                <Rectangle Width="1" Height="20" Fill="#555555" Margin="4,0"/>
                <Button x:Name="RescanButton" Content="Rescan" Command="{Binding RescanCommand}"/>
                <Rectangle Width="1" Height="20" Fill="#555555" Margin="4,0"/>
                <Button x:Name="BuildHakButton" Content="Build HAK" Command="{Binding BuildHakCommand}" Background="#007ACC" Foreground="#FFFFFF" FontWeight="Bold"/>
                <Rectangle Width="1" Height="20" Fill="#555555" Margin="4,0"/>
                <Button x:Name="SettingsButton" Content="Settings..." Command="{Binding OpenSettingsCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main 3-Pane Layout -->
        <Grid Grid.Row="1" ColumnDefinitions="280,4,*,4,380">
            <!-- Left: Source Stack -->
            <views:SourceStackView Grid.Column="0" DataContext="{Binding SourceStack}"/>

            <GridSplitter Grid.Column="1" Width="4" Background="#333333"/>

            <!-- Center: Assets table and the conflict-resolution queue as tabs. -->
            <TabControl Grid.Column="2">
                <TabItem Header="Assets">
                    <views:AssetTableView DataContext="{Binding AssetTable}"/>
                </TabItem>
                <TabItem Header="{Binding ConflictQueue.HeaderText}">
                    <views:ConflictQueueView DataContext="{Binding ConflictQueue}"/>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" Width="4" Background="#333333"/>

            <!-- Right: Comparison & Preview Panel -->
            <views:ComparisonPanelView Grid.Column="4" DataContext="{Binding ComparisonPanel}"/>
        </Grid>

        <!-- Expandable Operation Log Drawer -->
        <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,1,0,0" IsVisible="{Binding OperationLog.IsExpanded}">
            <Grid RowDefinitions="Auto,120">
                <Border Grid.Row="0" Padding="8,4" Background="#2D2D30">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Operation &amp; Diagnostic Log" FontWeight="Bold" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding OperationLog.ClearLogCommand}">Clear Log</Button>
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding OperationLog.Entries}" Background="#111111">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntryItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}]'}" Foreground="#666666" FontFamily="Consolas"/>
                                <TextBlock Text="{Binding Level}" FontWeight="Bold" Foreground="#007ACC" Width="50"/>
                                <TextBlock Text="{Binding Message}" Foreground="#CCCCCC"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Background="#007ACC" Padding="8,4">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusBar.StatusMessage}" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Value="{Binding StatusBar.ProgressFraction}" Minimum="0" Maximum="1" Width="150" IsVisible="{Binding StatusBar.IsBusy}" Margin="8,0"/>
                <Button Grid.Column="2" Command="{Binding StatusBar.CancelActiveOperationCommand}" IsVisible="{Binding StatusBar.IsBusy}" Margin="8,0">Cancel</Button>
                <Button Grid.Column="3" Command="{Binding OperationLog.ToggleDrawerCommand}" Margin="8,0">
                    <TextBlock Text="{Binding OperationLog.WarningCount, StringFormat='Log ({0} Warnings)'}" Foreground="#FFFFFF"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
